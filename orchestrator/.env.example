# Copy to .env and edit for a run without touching config.py. Values here
# win over the defaults in config.py; real environment variables win over
# both. See orchestrator/config.py for the role/agent tables.

# Per-role agent. Known agents: claude, codex, opencode.
FR_AGENT_IMPL=opencode
FR_AGENT_FIX=opencode
FR_AGENT_CRITIC=opencode
FR_AGENT_REVIEW=opencode
FR_AGENT_PLAN=opencode
FR_AGENT_RESOLVE=opencode
FR_AGENT_UNBLOCK=opencode
FR_AGENT_RETRO=opencode

# claude models per role (used only when the role's agent is claude).
FR_MODEL_IMPL=claude-sonnet-5
FR_MODEL_CRITIC=claude-opus-5
FR_MODEL_REVIEW=claude-opus-5
FR_MODEL_FIX=claude-opus-5
FR_MODEL_PLAN=claude-opus-5
FR_MODEL_RESOLVE=claude-opus-5
FR_MODEL_UNBLOCK=claude-opus-5

# opencode models per role (used only when the role's agent is opencode).
FR_OPENCODE_MODEL_IMPL=opencode/deepseek-v4-flash-free
FR_OPENCODE_MODEL_CRITIC=opencode/deepseek-v4-flash-free
FR_OPENCODE_MODEL_REVIEW=opencode/deepseek-v4-flash-free
FR_OPENCODE_MODEL_FIX=opencode/deepseek-v4-flash-free
FR_OPENCODE_MODEL_PLAN=opencode/deepseek-v4-flash-free
FR_OPENCODE_MODEL_RESOLVE=opencode/deepseek-v4-flash-free
FR_OPENCODE_MODEL_UNBLOCK=opencode/deepseek-v4-flash-free

# Review roster: reviewer 1, reviewer 2.
FR_REVIEWER1=opencode
FR_REVIEWER2=opencode

# The `duel` Agent: the agent pair (one entry == no agent rotation) and the
# opencode model pair that alternates across attempts.
FR_DUEL_AGENTS=opencode
FR_DUEL_MODELS=opencode/deepseek-v4-flash-free,opencode/hy3-free

# Escalation models: the final attempt of a failing issue.
FR_MODEL_ESCALATE=claude-opus-5
FR_OPENCODE_MODEL_ESCALATE=opencode/deepseek-v4-flash-free
